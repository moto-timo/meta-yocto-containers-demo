[Unit]
Description=Import bundled IoT Edge Gateway container images into podman storage
ConditionPathExists=!/var/lib/iot-gateway/.imported
After=local-fs.target
Before=iot-mosquitto.service iot-dataproc.service iot-nginx.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/iot-image-import.sh

[Install]
WantedBy=multi-user.target
