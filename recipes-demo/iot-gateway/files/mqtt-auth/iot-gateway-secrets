#!/bin/sh
# First boot: make this gateway's TLS certificate and passwords.
# Logins for people: /etc/iot-gateway/credentials (root only).
set -e
umask 077
d=/etc/iot-gateway
# nonroot user of the container images
uid=65532
mkdir -p $d/tls

if [ ! -f $d/tls/key.pem ]; then
    host=$(hostname)
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
        -days 3650 -subj "/CN=$host" \
        -addext "subjectAltName=DNS:$host,DNS:$host.local,DNS:localhost" \
        -keyout $d/tls/key.pem -out $d/tls/cert.pem
fi

if [ ! -f $d/credentials ]; then
    pw() { openssl rand -base64 18; }
    dataproc=$(pw); viewer=$(pw); admin=$(pw)
    for user in "dataproc $dataproc" "viewer $viewer"; do
        set -- $user
        podman run --rm --network none --user 0 -v $d:/w \
            --entrypoint /usr/bin/mosquitto_passwd docker.io/library/mosquitto:2 \
            -b $( [ -f $d/mosquitto.passwd ] || echo -c ) /w/mosquitto.passwd "$1" "$2"
    done
    printf 'admin:%s\n' "$(printf %s "$admin" | openssl passwd -6 -stdin)" > $d/htpasswd
    printf 'MQTT_USERNAME=dataproc\nMQTT_PASSWORD=%s\n' "$dataproc" > $d/dataproc.env
    cat > $d/credentials <<EOT
Dashboard  https://$(hostname).local:8443/  user admin   password $admin
MQTT       mqtts://$(hostname).local:8883   user viewer  password $viewer
CA         $d/tls/cert.pem (self-signed)
EOT
fi

# Containers (uid $uid) must enter tls/; the key stays 0600.
chown $uid:$uid $d/tls/key.pem $d/mosquitto.passwd $d/htpasswd
chmod 0755 $d/tls
chmod 0644 $d/tls/cert.pem
